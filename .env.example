FLASK_APP=backend.app
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/urbanwear_db

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_por_clave_aleatoria_minimo_32_bytes

# Genera con: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CAMBIA_ESTO_por_clave_aleatoria_minimo_64_bytes

GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# MercadoPago — obtén en https://www.mercadopago.com.co/developers
MP_ACCESS_TOKEN=TEST-tu_access_token_aqui
# Secret del webhook: Panel MP → Tu negocio → Configuración → Webhooks → Firma secreta
MP_WEBHOOK_SECRET=tu_webhook_secret_de_mercadopago

APP_BASE_URL=http://127.0.0.1:5000

# Orígenes permitidos en CORS (separados por coma). Por defecto usa APP_BASE_URL.
# Ejemplo producción: CORS_ORIGINS=https://urbanwear.com,https://www.urbanwear.com
CORS_ORIGINS=http://127.0.0.1:5000

# Gmail: activa "Contraseñas de aplicación" en tu cuenta Google
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
ADMIN_EMAIL=tu_correo@gmail.com

# Redis compartido entre workers de Gunicorn (rate limiter y cache).
# Si se omite, cada worker usa su propio rate limiter/cache en memoria (solo para desarrollo).
# Ejemplo: redis://localhost:6379/0
REDIS_URL=
